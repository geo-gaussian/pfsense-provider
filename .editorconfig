# Root EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
tab_width = 2

[{*.yaml,*.yml,*.tf,*.md}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
tab_width = 2

[Makefile]
indent_style = tab
tab_width = 2

[LICENSE]
trim_trailing_whitespace = false
