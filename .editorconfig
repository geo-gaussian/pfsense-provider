# Root EditorConfig file
root = true

# ---------------------------------------------------------
# Default settings for all files
# ---------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Use spaces by default
indent_style = space
indent_size = 2

# ---------------------------------------------------------
# JSON parameter files
# ---------------------------------------------------------
[*.json]
indent_style = space
indent_size = 2
insert_final_newline = true

# ---------------------------------------------------------
# YAML files (CI, config, metadata)
# ---------------------------------------------------------
[*.yml]
indent_style = space
indent_size = 2

[*.yaml]
indent_style = space
indent_size = 2

# ---------------------------------------------------------
# Markdown documentation
# ---------------------------------------------------------
[*.md]
indent_style = space
indent_size = 2

# ---------------------------------------------------------
# Git-related files
# ---------------------------------------------------------
[.gitignore]
indent_style = space
indent_size = 2

# ---------------------------------------------------------
# Shell scripts
# ---------------------------------------------------------
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# ---------------------------------------------------------
# License files
# ---------------------------------------------------------
[LICENSE]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
