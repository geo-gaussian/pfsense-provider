# Root EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
# Go source is formatted by gofmt, which intentionally uses tabs.
indent_style = tab
tab_width = 2

[Makefile]
indent_style = tab
tab_width = 2

[LICENSE]
trim_trailing_whitespace = false
